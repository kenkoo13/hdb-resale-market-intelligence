table dim_month
	lineageTag: 39280011-cbe5-5d5b-87a2-580b898aca32

	column month
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: e3f9c529-3fd7-5bbb-83d6-90433147cd65
		summarizeBy: none
		sourceColumn: month

	column year
		dataType: int64
		lineageTag: 41b19480-43a8-5f30-90cc-90f9906fb223
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: string
		lineageTag: 316729d5-8df7-5052-827d-bf917b06d4e0
		summarizeBy: none
		sourceColumn: quarter

	column month_label
		dataType: string
		lineageTag: de91e045-658a-5416-8b92-e49a8f582069
