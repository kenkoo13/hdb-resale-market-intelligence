		lineageTag: ed39eccf-62a0-5859-b54c-4e5d48819bbc
		summarizeBy: none
		sourceColumn: is_recent_24m

	partition dim_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CuratedFolder & "dim_month.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"month", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month_label", type text}, {"is_partial_month", Int64.Type}, {"months_before_last_full", Int64.Type}, {"is_latest_12m", Int64.Type}, {"is_prior_12m", Int64.Type}, {"is_recent_24m", Int64.Type}}, "en-US")
				in
				    Typed

