		lineageTag: 52b2f7f2-34e5-503c-baa4-db4db36e17ac
		summarizeBy: none
		sourceColumn: flat_type_order
		isHidden

	partition dim_flat_type = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CuratedFolder & "dim_flat_type.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
