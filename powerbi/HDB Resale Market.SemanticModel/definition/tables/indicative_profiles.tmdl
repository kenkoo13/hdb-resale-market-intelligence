	partition indicative_profiles = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CuratedFolder & "indicative_profiles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"town", type text}, {"flat_type", type text}, {"storey_variant", type text}, {"storey_range", type text}, {"flat_model", type text}, {"street_name", type text}, {"floor_area_sqm", type number}, {"remaining_lease_years", type number}, {"lease_commence_year", Int64.Type}, {"estimate_month", type text}, {"estimated_price", type number}, {"estimated_price_rounded", type number}, {"typical_error_pct", type number}, {"typical_error_sgd", Int64.Type}, {"reliability", type text}, {"segment_sales_latest_12m", Int64.Type}, {"segment_median_price_latest_12m", type number}, {"storey_band_sales_in_segment", Int64.Type}, {"estimate_vs_segment_median_pct", type number}, {"town_test_mdape_pct", type number}, {"flat_type_test_mdape_pct", type number}}, "en-US")
				in
				    Typed

