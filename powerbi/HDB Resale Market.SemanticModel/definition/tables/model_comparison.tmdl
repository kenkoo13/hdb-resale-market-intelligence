	column bias_median_pct
		dataType: double
		lineageTag: 6c583bce-dbf4-5137-94c1-13bb3288cf51
		summarizeBy: none
		sourceColumn: bias_median_pct

	partition model_comparison = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CuratedFolder & "model_comparison.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"model_label", type text}, {"mode", type text}, {"family", type text}, {"config", type text}, {"n", Int64.Type}, {"mae", type number}, {"rmse", type number}, {"r2", type number}, {"medae", type number}, {"mdape_pct", type number}, {"bias_median_pct", type number}}, "en-US")
				in
				    Typed

