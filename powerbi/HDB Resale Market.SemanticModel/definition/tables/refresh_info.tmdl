table refresh_info
	lineageTag: 9c93af2f-4cd9-5c71-98fb-a12b0782e1fc

	/// Coverage and refresh timestamp for report headers.
	measure 'Data Coverage Text' = "Data covers " & SELECTEDVALUE ( refresh_info[first_month_label] ) & " to " & SELECTEDVALUE ( refresh_info[last_full_month_label] ) & " (complete months). " & SELECTEDVALUE ( refresh_info[partial_month_label] ) & " is still being recorded and is left out of trends. Data downloaded " & SELECTEDVALUE ( refresh_info[retrieved_label] ) & "."
		displayFolder: Context
		lineageTag: 0424b584-8ccf-5027-a8ce-078a4b5a60cb

	/// Data licence attribution (Singapore Open Data Licence v1.0).
	measure 'Attribution Text' = SELECTEDVALUE ( refresh_info[attribution] )
		displayFolder: Context
		lineageTag: b4652669-455a-5732-8a5e-4ce147e6df0e

	column snapshot_id
		dataType: string
		lineageTag: ddaa4ad7-97ae-5a8f-818d-3ebebb52b5e1
		summarizeBy: none
		sourceColumn: snapshot_id

	column dataset_id
		dataType: string
		lineageTag: a37c7336-c33c-5239-afed-b4e2b3476240
		summarizeBy: none
		sourceColumn: dataset_id

	column retrieved_at_local
		dataType: string
		lineageTag: 6d392b34-855e-508c-8879-5dc5a6bc8557
		summarizeBy: none
		sourceColumn: retrieved_at_local

	column source_last_updated_at
		dataType: string
