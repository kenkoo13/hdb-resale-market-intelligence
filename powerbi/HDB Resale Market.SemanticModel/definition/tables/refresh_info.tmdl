		summarizeBy: none
		sourceColumn: source_last_updated_at

	column first_month
		dataType: string
		lineageTag: 7b5394bb-a5c6-5e28-b55d-7536e793f8e0
		summarizeBy: none
		sourceColumn: first_month

	column last_full_month
		dataType: string
		lineageTag: 20bd242e-dafe-5d28-87b2-b7b4d10fe5c6
		summarizeBy: none
		sourceColumn: last_full_month

	column partial_month
		dataType: string
		lineageTag: d4f54d29-4c1e-5094-aff8-6e17ba254a2d
		summarizeBy: none
		sourceColumn: partial_month

	column first_month_label
		dataType: string
		lineageTag: 5413ffb1-53e9-5099-8314-591d32c27626
		summarizeBy: none
		sourceColumn: first_month_label

	column last_full_month_label
		dataType: string
		lineageTag: e429a425-6937-596a-ac29-91fcd77fc89a
		summarizeBy: none
		sourceColumn: last_full_month_label

	column partial_month_label
		dataType: string
		lineageTag: 547500ed-d258-5779-b2d4-1f72c11964f2
		summarizeBy: none
		sourceColumn: partial_month_label

	column retrieved_label
		dataType: string
		lineageTag: 8bf0fcac-697e-5e9e-804b-c0cb69b5880f
		summarizeBy: none
		sourceColumn: retrieved_label

	column clean_rows
		dataType: int64
		lineageTag: e6bc5472-c2f0-5179-807a-39d7dcd221ee
		summarizeBy: none
		sourceColumn: clean_rows

	column quarantined_rows
		dataType: int64
		lineageTag: bc1fdfe1-8ac2-517d-84cf-398c66b8938d
		summarizeBy: none
		sourceColumn: quarantined_rows

	column attribution
		dataType: string
		lineageTag: 5ffeae29-9f61-5b66-ba9b-43816faeee50
		summarizeBy: none
		sourceColumn: attribution

	partition refresh_info = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CuratedFolder & "refresh_info.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"snapshot_id", type text}, {"dataset_id", type text}, {"retrieved_at_local", type text}, {"source_last_updated_at", type text}, {"first_month", type text}, {"last_full_month", type text}, {"partial_month", type text}, {"first_month_label", type text}, {"last_full_month_label", type text}, {"partial_month_label", type text}, {"retrieved_label", type text}, {"clean_rows", Int64.Type}, {"quarantined_rows", Int64.Type}, {"attribution", type text}}, "en-US")
				in
				    Typed

