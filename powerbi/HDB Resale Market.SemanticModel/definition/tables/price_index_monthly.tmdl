table price_index_monthly
	lineageTag: b73aebe1-41dc-5696-99c2-cbac891bd63f

	/// Raw monthly median price, 2017 = 100 (all flats; not affected by town/type slicers).
	measure 'Raw Median Index' = MAX ( price_index_monthly[raw_median_index] )
		formatString: 0.0
		displayFolder: Index
		lineageTag: 42d1c191-e8a1-567d-a93f-d64ed38d074f

	/// Hedonic time-dummy index for comparable flats, 2017 = 100 (DEC-017).
	measure 'Mix-Adjusted Index' = MAX ( price_index_monthly[mix_adjusted_index] )
		formatString: 0.0
		displayFolder: Index
		lineageTag: 210da847-9397-5182-a51a-a2be232c7e71

	column month
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: 33e660bb-a43d-5d52-b9a7-b4b4fb4a52c1
		summarizeBy: none
		sourceColumn: month

	column transactions
		dataType: int64
		lineageTag: 2a773e01-207f-5d37-a60f-fc2b9ee941c1
		summarizeBy: none
		sourceColumn: transactions

	column raw_median_index
		dataType: double
		lineageTag: 900b9e64-2db1-5c09-b5c0-f3de6c0dd19d
		summarizeBy: none
		sourceColumn: raw_median_index

	column mix_adjusted_index
		dataType: double
		lineageTag: abef5525-43b7-5e7e-b51c-ae4321090ca1
		summarizeBy: none
		sourceColumn: mix_adjusted_index

	partition price_index_monthly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CuratedFolder & "price_index_monthly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"month", type date}, {"transactions", Int64.Type}, {"raw_median_index", type number}, {"mix_adjusted_index", type number}}, "en-US")
				in
				    Typed

